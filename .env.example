# PrepForge Environment Variables
# Copy to .env and fill in values. NEVER commit .env to git.

# Required: Anthropic API key for AI coaching
ANTHROPIC_API_KEY=sk-ant-...

# Optional: password-protect the portal (leave blank for open access locally)
PORTAL_SECRET=

# Optional: Reddit API for better scraping (https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Server config
ENV=development
PORT=5555
ALLOWED_ORIGINS=http://localhost:5555,http://localhost:3000
